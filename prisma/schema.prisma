generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// Auth.js (NextAuth) Standard Models
// --------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials authentication
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  organizationUsers OrganizationUser[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// --------------------------------------
// Multi-Tenant & Data Infrastructure Models
// --------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationUser[]
  dbConnections DbConnection[]
  dashboards    Dashboard[]
}

model OrganizationUser {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model DbConnection {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  dbType            String   // mssql, postgres, mysql, snowflake
  host              String
  port              Int
  dbName            String
  username          String
  encryptedPassword String   @db.NVarChar(Max)
  schemaContext     String?  @db.Text
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Dashboard {
  id          String            @id @default(cuid())
  orgId       String
  name        String
  description String?           @db.NVarChar(Max)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  widgets      DashboardWidget[]
}

model DashboardWidget {
  id           String   @id @default(cuid())
  dashboardId  String
  title        String
  description  String?  @db.NVarChar(Max)
  chartType    String   // BAR, LINE, AREA, PIE, TABLE
  chartConfig  String   @db.NVarChar(Max) // JSON storing xAxisKey, dataKeys, title, colors
  rawQuery     String   @db.NVarChar(Max)
  connectionId String
  layout       String   @db.NVarChar(Max) // JSON storing { x, y, w, h, minW, minH }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

